{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goblin.io",
  "version": "../package.json",
  "identifier": "com.einfabo.goblinio",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Goblin.io",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "backgroundColor": "#141c0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["goblinio"] },
      "mobile": [{ "scheme": ["goblinio"], "appLink": false }]
    },
    "updater": {
      "endpoints": [
        "https://github.com/EinFabo/goblin-io/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQUU5M0Q4RDQwRDk5QjMKUldTem1RM1UySk91TU5QSEIwUkNMV0ZQSFF0a2JLdWtPd284NTQ0TThiQTE2czZHdTRLdkI0bisK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "EinFabo",
    "copyright": "© 2026 EinFabo",
    "shortDescription": "Goblin.io",
    "longDescription": "Überlebe als Goblin gegen Horden von Magiern.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false
      }
    }
  }
}
