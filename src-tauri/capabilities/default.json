{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Spiel-Fenster am Desktop: Auto-Update, Neustart, Fenster bei der Anmeldung minimieren und zurückholen",
  "platforms": ["windows", "linux", "macOS"],
  "windows": ["main"],
  "permissions": ["core:default", "opener:default", "updater:default", "process:allow-restart", "core:window:allow-minimize", "core:window:allow-unminimize", "core:window:allow-set-focus"]
}
